---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createToolSchema } from "../../utils/schema";

export const prerender = true;

export async function getStaticPaths() {
	const toolEntries = await getCollection("tools", ({ data }) => {
		return import.meta.env.PROD ? !data.draft : true;
	});

	return toolEntries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const hasBodyContent = (entry.body?.trim().length ?? 0) > 0;

const toolSchema = createToolSchema({
	title: entry.data.title,
	description: entry.data.description,
	url: Astro.url.pathname,
	image: entry.data.image,
	iframeUrl: entry.data.iframeUrl,
	openUrl: entry.data.openUrl,
	...(entry.data.publishDate && { publishDate: entry.data.publishDate }),
});
---

<style>
  .tool-detail {
    width: min(1100px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  .tool-detail__hero {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .tool-detail__eyebrow {
    width: fit-content;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background-color: rgba(255, 255, 255, 0.08);
    color: #d8d8d8;
  }

  .tool-detail__title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    margin: 0;
  }

  .tool-detail__description {
    max-width: 760px;
    color: var(--color-text-light);
    font-size: 1.05rem;
    margin: 0;
  }

  .tool-detail__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tool-detail__button,
  .tool-detail__back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .tool-detail__button {
    background-color: #f1f1f1;
    color: #111111;
    font-weight: 600;
  }

  .tool-detail__back {
    color: var(--color-text);
    background-color: rgba(255, 255, 255, 0.03);
  }

  .tool-detail__button:hover,
  .tool-detail__back:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.28);
  }

  .tool-detail__embed {
    margin: 2rem 0;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02)),
      #111111;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.32);
  }

  .tool-detail__embed-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--color-text-light);
    font-size: 0.95rem;
  }

  .tool-detail__embed-window {
    position: relative;
    width: 100%;
    min-height: 70vh;
  }

  .tool-detail__iframe {
    width: 100%;
    height: 70vh;
    border: 0;
    display: block;
    background-color: #ffffff;
  }

  .tool-detail__content {
    max-width: 780px;
  }

  .tool-detail__content :global(h2) {
    margin-top: 2rem;
  }

  .tool-detail__content :global(p),
  .tool-detail__content :global(ul),
  .tool-detail__content :global(ol) {
    color: var(--color-text-light);
  }

  @media (max-width: 768px) {
    .tool-detail {
      width: min(100%, calc(100% - 1rem));
    }

    .tool-detail__embed-window,
    .tool-detail__iframe {
      min-height: 60vh;
      height: 60vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-detail__button,
    .tool-detail__back {
      transition: none;
    }

    .tool-detail__button:hover,
    .tool-detail__back:hover {
      transform: none;
    }
  }
</style>

<BaseLayout
  pageTitle={entry.data.title}
  metaDescription={entry.data.description}
  metaKeywords={`tools, iframe, ${entry.data.title}`}
  ogImage={entry.data.image}
  schemaData={toolSchema}
>
  <article class="tool-detail">
    <header class="tool-detail__hero">
      <span class="tool-detail__eyebrow">Tool Detail</span>
      <h1 class="tool-detail__title text-gradient">{entry.data.title}</h1>
      <p class="tool-detail__description">{entry.data.description}</p>
      <div class="tool-detail__actions">
        <a
          class="tool-detail__button"
          href={entry.data.openUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Open in new tab
        </a>
        <a class="tool-detail__back" href="/tools">Back to tools</a>
      </div>
    </header>

    <section class="tool-detail__embed" aria-label={`Preview ${entry.data.title}`}>
      <div class="tool-detail__embed-header">
        <span>Live preview</span>
        <span>{entry.data.openUrl}</span>
      </div>
      <div class="tool-detail__embed-window">
        <iframe
          class="tool-detail__iframe"
          src={entry.data.iframeUrl}
          title={entry.data.title}
          loading="lazy"
          allow="clipboard-read; clipboard-write; fullscreen"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </section>

    {
      hasBodyContent && (
        <section class="tool-detail__content">
          <Content />
        </section>
      )
    }
  </article>
</BaseLayout>